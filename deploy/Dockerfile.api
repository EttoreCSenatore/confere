# API do Confere: usuário sem privilégio, sem cache de pip, sem segredos na imagem.
FROM python:3.15-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CONFERE_HOST=0.0.0.0 \
    CONFERE_PORTA=8000

# Correções de segurança do sistema operacional da imagem base.
RUN apt-get update && apt-get -y --no-install-recommends upgrade && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY api/pyproject.toml ./
COPY api/confere ./confere
# pip/setuptools/wheel saem da imagem final: reduzem a superfície de ataque (e os avisos de scanners).
RUN pip install . && pip uninstall -y pip setuptools wheel && rm -rf /app/pyproject.toml /app/confere

# O código instalado fica em site-packages; /app vazio e o processo roda como usuário comum.
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin confere
USER 10001:10001

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3).status == 200 else 1)"]
CMD ["python", "-m", "confere"]
