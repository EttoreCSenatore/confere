# Copie para .env. Nenhum segredo é necessário: o Confere não tem banco nem contas.
# Domínio público (DNS apontando para este servidor; portas 80 e 443 abertas para o certificado automático).
CONFERE_DOMAIN=confere.exemplo.org
# E-mail da conta ACME (Let's Encrypt): use um endereço DEDICADO do projeto, nunca um e-mail pessoal.
CONFERE_ACME_EMAIL=privacidade@exemplo.org
# Opcional
CONFERE_LIMITE_POR_MINUTO=30
CONFERE_CACHE_TTL=600
# Cópia local dos dados abertos mais nova que N dias é usada sem consultar a BrasilAPI (0 = sempre a fonte)
CONFERE_SNAPSHOT_MAX_DIAS=14
CONFERE_CACHE_TTL_DADOS=86400
# Só para testar localmente (portas sem privilégio no hospedeiro, certificado de uma CA interna do Caddy):
# CONFERE_DOMAIN=localhost
# CONFERE_HTTP_PORT=18080
# CONFERE_HTTPS_PORT=18443
